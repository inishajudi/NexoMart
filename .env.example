# NexoMart - required configuration values.
# Copy relevant values into src/main/resources/config.properties for local dev
# (see config.properties.example). Real values must never be committed.

# --- Database ---
DB_URL=jdbc:h2:./data/nexomart;AUTO_SERVER=TRUE
DB_USER=sa
DB_PASSWORD=

