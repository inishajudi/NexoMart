<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<%@ page import="com.nexomart.app.filter.AuthFilter" %>
<%@ page import="com.nexomart.app.model.User" %>
<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>NexoMart</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        /* ── DESIGN TOKENS ─────────────────────────────────────────────────── */
        :root {
            --bg:             #ffffff;
            --surface:        #ffffff;
            --surface-hover:  #f5f5f5;
            --border:         #e0e0e0;
            --border-strong:  #000000;
            --accent:         #000000;
            --accent-hover:   #222222;
            --accent-light:   #f0f0f0;
            --on-accent:      #ffffff;
            --text:           #000000;
            --text-muted:     #444444;
            --text-faint:     #888888;
            --success-bg:     #f0fff4;
            --success-border: #000000;
            --success-text:   #000000;
            --error-bg:       #fff0f0;
            --error-border:   #000000;
            --error-text:     #000000;
            --radius:         8px;
            --radius-sm:      5px;
            --shadow-sm:      0 1px 3px rgba(0,0,0,0.10);
            --shadow-md:      0 4px 16px rgba(0,0,0,0.12);
            --shadow-lg:      0 12px 40px rgba(0,0,0,0.16);
        }

        /* ── RESET & BASE ──────────────────────────────────────────────────── */
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
            background: var(--bg);
            color: var(--text);
            line-height: 1.6;
            -webkit-font-smoothing: antialiased;
        }

        /* ── HEADER / NAV ──────────────────────────────────────────────────── */
        header {
            background: #ffffff;
            border-bottom: 1.5px solid #000000;
            padding: 0 40px;
            height: 60px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            position: sticky;
            top: 0;
            z-index: 50;
        }

        header .brand {
            font-size: 20px;
            font-weight: 800;
            color: #000000;
            text-decoration: none;
            letter-spacing: -0.04em;
            display: inline-flex;
            align-items: center;
            gap: 10px;
            margin-right: 32px;
        }

        header .brand::before {
            content: "N";
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 32px;
            height: 32px;
            border-radius: 6px;
            background: #000000;
            color: #ffffff;
            font-size: 15px;
            font-weight: 800;
        }

        .tagline {
            color: var(--text-faint);
            font-size: 11px;
            font-weight: 600;
            letter-spacing: 0.12em;
            text-transform: uppercase;
            margin-right: auto;
        }

        header a {
            color: var(--text-muted);
            text-decoration: none;
            font-size: 14px;
            font-weight: 500;
            padding: 6px 12px;
            border-radius: var(--radius-sm);
            transition: color 0.12s, background 0.12s;
        }

        header a:hover {
            color: #000000;
            background: var(--accent-light);
        }

        /* ── MAIN CONTENT AREA ─────────────────────────────────────────────── */
        main {
            max-width: 1160px;
            margin: 36px auto 64px;
            padding: 0 20px;
        }

        /* ── CARD ──────────────────────────────────────────────────────────── */
        .card {
            background: #ffffff;
            border: 1.5px solid #000000;
            border-radius: var(--radius);
            padding: 24px;
            margin-bottom: 16px;
            box-shadow: var(--shadow-sm);
            transition: box-shadow 0.18s, transform 0.15s;
        }

        .product-grid .card:hover {
            box-shadow: var(--shadow-md);
            transform: translateY(-3px);
        }

        /* ── FLASH / ERROR BANNERS ─────────────────────────────────────────── */
        .flash {
            background: var(--success-bg);
            border: 1.5px solid var(--success-border);
            color: var(--success-text);
            padding: 12px 16px;
            border-radius: var(--radius-sm);
            margin-bottom: 16px;
            font-size: 14px;
            font-weight: 500;
        }

        .error {
            background: var(--error-bg);
            border: 1.5px solid var(--error-border);
            color: var(--error-text);
            padding: 12px 16px;
            border-radius: var(--radius-sm);
            margin-bottom: 16px;
            font-size: 14px;
            font-weight: 500;
        }

        /* ── FORM ELEMENTS ─────────────────────────────────────────────────── */
        input, select, textarea {
            width: 100%;
            padding: 11px 13px;
            margin: 6px 0 14px;
            border: 1.5px solid #000000;
            border-radius: var(--radius-sm);
            background: #ffffff;
            color: #000000;
            font-family: inherit;
            font-size: 14px;
            transition: box-shadow 0.12s;
            outline: none;
        }

        input:focus, select:focus, textarea:focus {
            box-shadow: 0 0 0 3px rgba(0,0,0,0.12);
        }

        label {
            display: block;
            font-weight: 600;
            font-size: 12px;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 0.06em;
        }

        /* ── BUTTONS ───────────────────────────────────────────────────────── */
        button, .btn {
            background: #000000;
            color: #ffffff;
            border: 1.5px solid #000000;
            padding: 11px 24px;
            border-radius: var(--radius-sm);
            cursor: pointer;
            font-size: 14px;
            font-weight: 700;
            text-decoration: none;
            display: inline-block;
            font-family: inherit;
            transition: background 0.12s, color 0.12s;
        }

        button:hover, .btn:hover {
            background: var(--accent-hover);
        }

        button:active, .btn:active {
            transform: scale(0.98);
        }

        .btn-outline {
            background: #ffffff;
            color: #000000;
            border: 1.5px solid #000000;
            padding: 10px 22px;
            border-radius: var(--radius-sm);
            text-decoration: none;
            font-weight: 600;
            font-size: 14px;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            transition: background 0.12s;
        }

        .btn-outline:hover {
            background: var(--accent-light);
        }

        /* ── TABLES ────────────────────────────────────────────────────────── */
        table { width: 100%; border-collapse: collapse; }

        th {
            text-align: left;
            padding: 10px 12px;
            border-bottom: 2px solid #000000;
            font-size: 11.5px;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            color: var(--text-muted);
            font-weight: 700;
        }

        td {
            text-align: left;
            padding: 12px;
            border-bottom: 1px solid var(--border);
            font-size: 14.5px;
        }

        tr:last-child td { border-bottom: none; }

        /* ── TYPOGRAPHY HELPERS ────────────────────────────────────────────── */
        h1, h2, h3, h4 {
            font-family: 'Inter', sans-serif;
            font-weight: 800;
            letter-spacing: -0.03em;
            color: #000000;
        }

        .muted  { color: var(--text-muted); font-size: 13px; }
        .price  { font-weight: 700; color: #000000; font-size: 18px; }
        .price::before { content: "\20B9"; font-weight: 600; margin-right: 1px; }

        /* ── PRODUCT GRID ──────────────────────────────────────────────────── */
        .product-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
            gap: 20px;
        }

        /* ── HERO ──────────────────────────────────────────────────────────── */
        .eyebrow {
            display: inline-block;
            color: #000000;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 0.18em;
            text-transform: uppercase;
            margin-bottom: 20px;
            padding-left: 26px;
            position: relative;
        }
        .eyebrow::before {
            content: "";
            position: absolute;
            left: 0; top: 50%;
            transform: translateY(-50%);
            width: 18px; height: 1.5px;
            background: #000000;
        }

        .hero-title {
            font-size: clamp(42px, 7vw, 72px);
            font-weight: 800;
            letter-spacing: -0.055em;
            line-height: 0.97;
            color: #000000;
            margin-bottom: 22px;
        }
        .hero-title .accent { color: #000000; font-style: italic; }

        .hero-subtitle {
            font-size: 16px;
            color: var(--text-muted);
            line-height: 1.7;
            margin-bottom: 32px;
            max-width: 520px;
        }

        .hero-actions { display: flex; align-items: center; gap: 16px; flex-wrap: wrap; }

        /* ── SECTION HEADING ───────────────────────────────────────────────── */
        .section-heading {
            display: flex;
            align-items: baseline;
            justify-content: space-between;
            margin: 56px 0 22px;
            flex-wrap: wrap;
            gap: 8px;
        }
        .section-heading h2 { font-size: 28px; }
        .section-heading a  { color: #000000; font-size: 14px; font-weight: 600; text-decoration: none; }

        /* ── CATEGORY TILES ────────────────────────────────────────────────── */
        .category-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
            gap: 14px;
            margin-bottom: 8px;
        }
        .category-tile {
            background: #ffffff;
            border: 1.5px solid #000000;
            border-radius: var(--radius);
            padding: 26px 16px;
            text-align: center;
            text-decoration: none;
            color: #000000;
            font-weight: 600;
            font-size: 14px;
            transition: background 0.12s, transform 0.12s;
        }
        .category-tile:hover {
            background: var(--accent-light);
            transform: translateY(-2px);
        }

        /* ── REVIEW ITEM ───────────────────────────────────────────────────── */
        .review-item {
            border-bottom: 1px solid var(--border);
            padding: 12px 0;
        }
        .review-item:last-child { border-bottom: none; }

        /* ── STATUS / ROLE BADGES ──────────────────────────────────────────── */
        .status-badge, .role-badge {
            display: inline-block;
            padding: 3px 10px;
            font-size: 11.5px;
            font-weight: 700;
            letter-spacing: 0.05em;
            color: #ffffff;
            background: #000000;
            border-radius: 999px;
        }
        .status-badge.shipped { background: #444444; }

        /* ── AUTH CARD ─────────────────────────────────────────────────────── */
        .auth-card {
            background: #ffffff;
            border: 1.5px solid #000000;
            border-radius: var(--radius);
            padding: 36px 32px;
            max-width: 440px;
            margin: 40px auto;
            box-shadow: var(--shadow-md);
        }
        .auth-card h2 { font-size: 26px; margin-bottom: 6px; color: #000000; }
        .auth-sub     { color: var(--text-muted); font-size: 14px; margin-bottom: 24px; }
        .auth-foot    { margin-top: 18px; font-size: 13px; color: var(--text-muted); }
        .auth-foot a  { color: #000000; font-weight: 600; }
        .auth-demo    {
            margin-top: 20px;
            padding: 12px 14px;
            background: #f5f5f5;
            border: 1.5px solid #000000;
            border-radius: var(--radius-sm);
            font-size: 12.5px;
            color: var(--text-muted);
        }

        /* ── SAND CARD (seller orders / admin pages) ───────────────────────── */
        .sand-card {
            background: #ffffff;
            border: 1.5px solid #000000;
            border-radius: var(--radius);
            padding: 24px;
            margin-bottom: 20px;
            box-shadow: var(--shadow-sm);
        }
        .page-title  { font-size: 34px; font-weight: 800; color: #000000; margin: 32px 0 20px; }
        .order-head  { display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px; }
        .order-date  { color: var(--text-faint); font-size: 13px; }
        .order-meta  { color: var(--text-muted); font-size: 14px; margin-bottom: 6px; }
        .alert-error {
            background: var(--error-bg);
            border: 1.5px solid #000000;
            color: #000000;
            border-radius: var(--radius-sm);
            padding: 12px 16px;
            margin-bottom: 16px;
        }

        .sand-table          { width: 100%; border-collapse: collapse; margin-top: 10px; }
        .sand-table th       { text-align: left; font-size: 11.5px; text-transform: uppercase; letter-spacing: 0.07em; color: var(--text-muted); padding: 10px 12px; border-bottom: 2px solid #000000; }
        .sand-table td       { padding: 12px; border-bottom: 1px solid var(--border); color: #000000; }
        .sand-table tr:last-child td { border-bottom: none; }

        /* Ship button */
        .btn-ship {
            background: #000000;
            color: #ffffff;
            border: none;
            border-radius: var(--radius-sm);
            padding: 6px 16px;
            font-size: 13px;
            font-weight: 700;
            cursor: pointer;
            font-family: inherit;
        }
        .btn-ship:hover { background: #333333; }

        /* Wishlist page cards */
        .wish-grid  { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 20px; }
        .wish-card  { background: #ffffff; border: 1.5px solid #000000; border-radius: var(--radius); overflow: hidden; display: flex; flex-direction: column; }
        .wish-img   { width: 100%; height: 180px; object-fit: cover; }
        .wish-body  { padding: 16px; flex: 1; display: flex; flex-direction: column; gap: 6px; }
        .wish-name  { font-weight: 700; color: #000000; font-size: 15px; }
        .wish-cat   { font-size: 12px; color: var(--text-faint); }
        .wish-price { font-size: 16px; font-weight: 700; color: #000000; }
        .wish-foot  { padding: 12px 16px; border-top: 1.5px solid #000000; display: flex; gap: 8px; }
        .btn-wish-cart   { flex: 1; background: #000000; color: #fff; border: none; border-radius: var(--radius-sm); padding: 8px 0; font-size: 13px; font-weight: 700; cursor: pointer; text-align: center; font-family: inherit; }
        .btn-wish-cart:hover  { background: #333333; }
        .btn-wish-remove { background: transparent; border: 1.5px solid #000000; color: #000000; border-radius: var(--radius-sm); padding: 8px 12px; font-size: 13px; cursor: pointer; font-family: inherit; }
        .btn-wish-remove:hover { background: #f0f0f0; }

        /* ── RESPONSIVE ────────────────────────────────────────────────────── */
        @media (max-width: 760px) {
            header { padding: 0 16px; height: auto; min-height: 56px; flex-wrap: wrap; gap: 10px; padding-top: 10px; padding-bottom: 10px; }
            header > div:last-child { flex-wrap: wrap; justify-content: flex-end; }
            header a { padding: 5px 8px; font-size: 12px; }
            header .brand { margin-right: 0; font-size: 17px; }
            .tagline { display: none; }
            main { margin-top: 24px; padding: 0 14px; }
            .product-grid { grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)); gap: 12px; }
            .card { padding: 16px; }
            .hero-title { font-size: 38px; }
        }
    </style>
</head>
<body>
<header>
    <div style="display:flex; align-items:center;">
        <a href="<c:url value='/'/>" class="brand">NexoMart</a>
        <span class="tagline">Marketplace</span>
    </div>
    <div style="display:flex; align-items:center; gap:2px;">
        <%
            User navUser = (session == null) ? null : (User) session.getAttribute(AuthFilter.SESSION_USER_ATTR);
            if (navUser != null) {
        %>
        <a href="<c:url value='/products'/>">Browse</a>
        <a href="<c:url value='/cart'/>">Cart</a>
        <a href="<c:url value='/orders'/>">Orders</a>
        <% if (navUser.getRole().name().equals("BUYER")) { %>
        <a href="<c:url value='/wishlist'/>">Wishlist</a>
        <% } %>
        <% if (navUser.getRole().name().equals("SELLER")) { %>
        <a href="<c:url value='/products/create'/>">List a Product</a>
        <a href="<c:url value='/orders/seller'/>">My Sales</a>
        <% } %>
        <% if (navUser.getRole().name().equals("ADMIN")) { %>
        <a href="<c:url value='/admin/dashboard'/>">Admin Dashboard</a>
        <% } %>
            <span class="muted" style="margin:0 12px; font-size:13px;">Hi, <c:out value="<%= navUser.getName() %>"/></span>
            <a href="<c:url value='/logout'/>" style="border:1.5px solid #000; border-radius:var(--radius-sm);">Log out</a>
        <% } else { %>
        <a href="<c:url value='/products'/>">Browse</a>
        <a href="<c:url value='/login'/>" style="border:1.5px solid #000; border-radius:var(--radius-sm); margin-left:8px;">Log in</a>
        <a href="<c:url value='/register'/>" class="btn" style="margin-left:8px;">Join</a>
        <% } %>
    </div>
</header>
<main>
<%
    Object flash = (session == null) ? null : session.getAttribute("flashMessage");
    if (flash != null) {
        session.removeAttribute("flashMessage");
        request.setAttribute("flashMessage", flash);
%>
    <div class="flash"><c:out value="${flashMessage}"/></div>
<% } %>
<c:if test="${not empty errorMessage}">
    <div class="error"><c:out value="${errorMessage}"/></div>
</c:if>