<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<%@ page import="com.nexomart.app.filter.AuthFilter" %>
<%@ page import="com.nexomart.app.model.User" %>
<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>NexoMart</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg: #f3ead8;
            --surface: #faf5e9;
            --surface-hover: #ede2cb;
            --border: #e0d3b8;
            --border-strong: #cdbd9c;
            --brass: #9a6a24;
            --brass-hover: #7f551a;
            --brass-light: #efe3c8;
            --on-accent: #ffffff;
            --text: #2b241a;
            --text-muted: #6b5f4b;
            --text-faint: #8f836d;
            --success-bg: #e9f0dd;
            --success-border: #b9cf9c;
            --success-text: #3f6b22;
            --error-bg: #f7e4dd;
            --error-border: #e0b3a5;
            --error-text: #a3392a;
            --radius: 8px;
            --radius-sm: 5px;
            --shadow-sm: 0 1px 3px rgba(80, 60, 20, 0.10);
            --shadow-md: 0 8px 20px rgba(80, 60, 20, 0.15);
            --shadow-lg: 0 20px 50px rgba(80, 60, 20, 0.20);
        }
        * { box-sizing: border-box; }
        body {
            font-family: 'DM Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
            margin: 0;
            background: var(--bg);
            color: var(--text);
            line-height: 1.55;
            -webkit-font-smoothing: antialiased;
        }
        header {
            background: var(--bg);
            padding: 20px 40px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid var(--border);
            position: sticky;
            top: 0;
            z-index: 50;
        }
        header a {
            color: var(--text-muted);
            text-decoration: none;
            margin-right: 4px;
            padding: 8px 14px;
            border-radius: var(--radius-sm);
            font-weight: 500;
            font-size: 14px;
            transition: all 0.15s ease;
        }
        header a:hover { color: var(--brass); }
        header .brand {
            font-family: 'DM Serif Display', Georgia, serif;
            font-size: 24px;
            font-weight: 400;
            margin-right: 32px;
            color: var(--text);
            letter-spacing: 0.01em;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
        }
        header .brand::before {
            content: "C";
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 32px;
            height: 32px;
            border-radius: 50%;
            background: linear-gradient(135deg, #b8843a, #8a5d1f);
            color: #ffffff;
            font-family: 'DM Serif Display', serif;
            font-weight: 400;
            font-size: 17px;
            margin-right: 12px;
        }
        .tagline { color: var(--text-faint); font-size: 13px; letter-spacing: 0.08em; text-transform: uppercase; margin-right: auto; }
        main { max-width: 1100px; margin: 32px auto; padding: 0 20px; }
        .card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            padding: 22px;
            margin-bottom: 16px;
            box-shadow: var(--shadow-sm);
            transition: box-shadow 0.2s ease, transform 0.15s ease, border-color 0.2s ease;
        }
        .product-grid .card:hover {
            box-shadow: var(--shadow-md);
            border-color: var(--brass);
            transform: translateY(-3px);
        }
        .flash {
            background: var(--success-bg);
            border: 1px solid var(--success-border);
            color: var(--success-text);
            padding: 12px 16px;
            border-radius: var(--radius-sm);
            margin-bottom: 16px;
            font-size: 14px;
            font-weight: 500;
        }
        .error {
            background: var(--error-bg);
            border: 1px solid var(--error-border);
            color: var(--error-text);
            padding: 12px 16px;
            border-radius: var(--radius-sm);
            margin-bottom: 16px;
            font-size: 14px;
            font-weight: 500;
        }
        input, select, textarea {
            width: 100%;
            padding: 11px 12px;
            margin: 6px 0 14px;
            box-sizing: border-box;
            border: 1px solid var(--border-strong);
            border-radius: var(--radius-sm);
            background: #fffdf7;
            color: var(--text);
            font-family: inherit;
            font-size: 14px;
            transition: border-color 0.15s ease;
        }
        input:focus, select:focus, textarea:focus {
            outline: none;
            border-color: var(--brass);
        }
        label { font-weight: 600; font-size: 12.5px; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.06em; }
        button, .btn {
            background: var(--brass);
            color: var(--on-accent);
            border: none;
            padding: 12px 24px;
            border-radius: var(--radius-sm);
            cursor: pointer;
            font-size: 14px;
            font-weight: 700;
            text-decoration: none;
            display: inline-block;
            transition: background 0.15s ease, transform 0.1s ease;
            font-family: inherit;
        }
        button:hover, .btn:hover { background: var(--brass-hover); }
        button:active, .btn:active { transform: scale(0.98); }
        table { width: 100%; border-collapse: collapse; }
        th {
            text-align: left;
            padding: 10px 12px;
            border-bottom: 2px solid var(--border-strong);
            font-size: 11.5px;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            color: var(--text-muted);
            font-weight: 700;
        }
        td { text-align: left; padding: 12px; border-bottom: 1px solid var(--border); font-size: 14.5px; }
        .product-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); gap: 20px; }
        .muted { color: var(--text-muted); font-size: 13px; }
        .price { font-weight: 700; color: var(--brass); font-size: 18px; }
        .price::before { content: "\20B9"; font-weight: 600; margin-right: 1px; opacity: 0.8; }

        h1, h2, h3 { font-family: 'DM Serif Display', Georgia, serif; font-weight: 400; }

        .icon-sm { width: 16px; height: 16px; display: inline-block; vertical-align: middle; }
        .icon-lg { width: 26px; height: 26px; display: block; margin: 0 auto 10px; color: var(--brass); }

        .eyebrow {
            display: inline-block;
            color: var(--brass);
            font-size: 12.5px;
            font-weight: 700;
            letter-spacing: 0.16em;
            text-transform: uppercase;
            margin-bottom: 22px;
            position: relative;
            padding-left: 28px;
        }
        .eyebrow::before {
            content: "";
            position: absolute;
            left: 0;
            top: 50%;
            transform: translateY(-50%);
            width: 20px;
            height: 1px;
            background: var(--brass);
        }
        .hero-title {
            font-size: 58px;
            line-height: 1.1;
            font-weight: 400;
            color: var(--text);
            margin: 0 0 22px;
        }
        .hero-title .accent { color: var(--brass); font-style: italic; }
        .hero-subtitle {
            font-size: 17px;
            font-family: 'DM Sans', sans-serif;
            color: var(--text-muted);
            line-height: 1.7;
            margin-bottom: 32px;
            max-width: 480px;
        }
        .hero-actions { display: flex; align-items: center; gap: 20px; flex-wrap: wrap; }
        .btn-outline {
            background: transparent;
            color: var(--brass);
            border: 1px solid var(--border-strong);
            padding: 11px 24px;
            border-radius: var(--radius-sm);
            text-decoration: none;
            font-weight: 600;
            font-size: 14px;
            transition: all 0.15s ease;
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }
        .btn-outline:hover { border-color: var(--brass); background: var(--brass-light); }

        .section-heading { display: flex; align-items: baseline; justify-content: space-between; margin: 56px 0 22px; flex-wrap: wrap; gap: 8px; }
        .section-heading h2 { font-size: 30px; margin: 0; }
        .section-heading a { color: var(--brass); font-size: 14px; font-weight: 600; text-decoration: none; }

        .category-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)); gap: 16px; margin-bottom: 8px; }
        .category-tile {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            padding: 26px 16px;
            text-align: center;
            text-decoration: none;
            color: var(--text);
            font-weight: 600;
            font-size: 14px;
            transition: all 0.15s ease;
        }
        .category-tile:hover { border-color: var(--brass); box-shadow: var(--shadow-sm); transform: translateY(-2px); }

         /* NexoMart studio theme */
         :root {
             --bg: #f5f7fb;
             --surface: #ffffff;
             --surface-hover: #eef2ff;
             --border: #e4e7ec;
             --border-strong: #cbd2df;
             --brass: #5b5ce2;
             --brass-hover: #4647c4;
             --brass-light: #eef0ff;
             --on-accent: #ffffff;
             --text: #172033;
             --text-muted: #667085;
             --text-faint: #98a2b3;
             --success-bg: #ecfdf3;
             --success-border: #a6f4c5;
             --success-text: #067647;
             --error-bg: #fff1f3;
             --error-border: #fda4af;
             --error-text: #be123c;
             --radius: 16px;
             --radius-sm: 10px;
             --shadow-sm: 0 2px 8px rgba(16, 24, 40, 0.05);
             --shadow-md: 0 12px 28px rgba(16, 24, 40, 0.10);
             --shadow-lg: 0 24px 60px rgba(16, 24, 40, 0.18);
         }
         body {
             background:
                 radial-gradient(circle at 12% 4%, rgba(91, 92, 226, 0.08), transparent 28rem),
                 var(--bg);
             color: var(--text);
         }
         header {
             background: rgba(255, 255, 255, 0.88);
             border-bottom: 1px solid rgba(228, 231, 236, 0.9);
             padding: 16px 40px;
             backdrop-filter: blur(16px);
         }
         header a { color: var(--text-muted); border-radius: 999px; }
         header a:hover { color: var(--brass); background: var(--brass-light); }
         header .brand {
             font-family: 'DM Sans', sans-serif;
             font-size: 20px;
             font-weight: 800;
             letter-spacing: -0.04em;
             color: var(--text);
         }
         header .brand::before {
             content: "N";
             width: 34px;
             height: 34px;
             border-radius: 11px;
             background: linear-gradient(135deg, #6b6df3, #4849c6);
             font-family: 'DM Sans', sans-serif;
             font-size: 16px;
             font-weight: 800;
             margin-right: 10px;
             box-shadow: 0 5px 12px rgba(91, 92, 226, 0.28);
         }
         .tagline { color: var(--text-faint); font-size: 11px; font-weight: 700; letter-spacing: 0.12em; }
         main { max-width: 1180px; margin: 36px auto 56px; }
         .card {
             background: rgba(255, 255, 255, 0.94);
             border: 1px solid var(--border);
             border-radius: var(--radius);
             padding: 24px;
             box-shadow: var(--shadow-sm);
         }
         .product-grid .card:hover {
             border-color: rgba(91, 92, 226, 0.45);
             box-shadow: var(--shadow-md);
             transform: translateY(-5px);
         }
         input, select, textarea {
             padding: 12px 14px;
             border-color: var(--border-strong);
             border-radius: var(--radius-sm);
             background: #fcfcfd;
             color: var(--text);
         }
         input:focus, select:focus, textarea:focus {
             border-color: var(--brass);
             box-shadow: 0 0 0 4px rgba(91, 92, 226, 0.12);
         }
         label { color: var(--text-muted); }
         button, .btn {
             background: linear-gradient(135deg, #6b6df3, #5556d9);
             border-radius: 999px;
             box-shadow: 0 5px 12px rgba(91, 92, 226, 0.18);
         }
         button:hover, .btn:hover { background: linear-gradient(135deg, #5556d9, #4647c4); }
         .btn-outline {
             color: var(--brass);
             border-color: var(--border-strong);
             border-radius: 999px;
         }
         .btn-outline:hover { border-color: var(--brass); background: var(--brass-light); }
         .hero-title {
             font-family: 'DM Sans', sans-serif;
             font-size: clamp(42px, 7vw, 76px);
             font-weight: 800;
             letter-spacing: -0.065em;
             line-height: 0.98;
             max-width: 750px;
         }
         .hero-title .accent { color: var(--brass); font-style: normal; }
         .hero-subtitle { color: var(--text-muted); max-width: 560px; }
         .eyebrow { color: var(--brass); font-size: 11px; letter-spacing: 0.18em; }
         .section-heading { margin-top: 64px; }
         .section-heading h2, h1, h2, h3 { font-family: 'DM Sans', sans-serif; font-weight: 800; letter-spacing: -0.035em; }
         .section-heading h2 { font-size: 28px; }
         .category-tile {
             background: rgba(255, 255, 255, 0.82);
             border-color: var(--border);
             border-radius: var(--radius);
         }
         .category-tile:hover { border-color: var(--brass); box-shadow: var(--shadow-sm); }
         .price { color: var(--brass); }
         th { color: var(--text-muted); border-color: var(--border-strong); }
         td { border-color: var(--border); }
         .muted { color: var(--text-muted); }
         .flash, .error { border-radius: var(--radius-sm); }
         .flash { box-shadow: var(--shadow-sm); }
         .theme-modern .auth-card,
         .theme-modern .sand-card {
             background: rgba(255, 255, 255, 0.96);
             border-color: var(--border);
             border-radius: 20px;
             box-shadow: var(--shadow-md);
         }
         .theme-modern .auth-card h2,
         .theme-modern .page-title,
         .theme-modern .sand-card h3 { color: var(--text); }
         .theme-modern .auth-sub,
         .theme-modern .empty-note,
         .theme-modern .order-date,
         .theme-modern .order-meta { color: var(--text-muted); }
         .theme-modern .auth-card label { color: var(--text-muted); }
         .theme-modern .auth-card input,
         .theme-modern .auth-card select,
         .theme-modern .auth-card textarea {
             color: var(--text);
             background: #fcfcfd;
             border-color: var(--border-strong);
         }
         .theme-modern .auth-card input:focus,
         .theme-modern .auth-card select:focus,
         .theme-modern .auth-card textarea:focus {
             border-color: var(--brass);
             box-shadow: 0 0 0 4px rgba(91, 92, 226, 0.12);
         }
         .theme-modern .auth-card button[type=submit],
         .theme-modern .sand-btn { background: linear-gradient(135deg, #6b6df3, #5556d9); border-radius: 999px; }
         .theme-modern .auth-card button[type=submit]:hover,
         .theme-modern .sand-btn:hover { background: linear-gradient(135deg, #5556d9, #4647c4); }
         .theme-modern .auth-foot,
         .theme-modern .auth-demo,
         .theme-modern .mock-note { color: var(--text-muted); }
         .theme-modern .auth-demo,
         .theme-modern .mock-note { background: #f3f4ff; border-color: #c7c9ff; }
         .theme-modern .sand-table th { color: var(--text-muted); border-color: var(--border-strong); }
         .theme-modern .sand-table td { color: var(--text); border-color: var(--border); }
         .theme-modern .sand-table tr:hover td { background: #f8f9ff; }
         .theme-modern .sand-table button,
         .theme-modern .sand-card button {
             background: linear-gradient(135deg, #6b6df3, #5556d9);
             color: #fff;
             border-color: transparent;
             border-radius: 999px;
         }
         .theme-modern .sand-table button:hover,
         .theme-modern .sand-card button:hover { background: linear-gradient(135deg, #5556d9, #4647c4); }
         .theme-modern .sand-table button.btn-danger,
         .theme-modern .sand-card button.btn-danger {
             color: #be123c;
             background: #fff1f3;
             border: 1px solid #fda4af;
             box-shadow: none;
         }
         .theme-modern .sand-table button.btn-danger:hover,
         .theme-modern .sand-card button.btn-danger:hover { background: #ffe4e8; }
         .theme-modern .total-line,
         .theme-modern .total-line strong { color: var(--text); }
         .theme-modern .total-line strong { color: var(--brass); }
         .theme-modern .product-grid .card img { background: #eef0ff; }
         .theme-modern .review-item { border-bottom: 1px solid var(--border); padding: 12px 0; }
         .theme-modern .status-badge,
         .theme-modern .role-badge {
             color: #4849c6;
             background: #eef0ff;
         }
         .theme-modern .form-error { color: var(--error-text); background: var(--error-bg); border-color: var(--error-border); }
         .theme-modern .back-link,
         .theme-modern .empty-note a { color: var(--brass); }
         @media (max-width: 760px) {
             header { padding: 13px 16px; align-items: flex-start; gap: 12px; }
             header > div:last-child { flex-wrap: wrap; justify-content: flex-end; }
             header a { padding: 6px 9px; font-size: 12px; }
             header .brand { margin-right: 0; }
             .tagline { display: none; }
             main { margin-top: 24px; padding: 0 14px; }
             .hero-title { font-size: 46px; }
             .product-grid { grid-template-columns: repeat(auto-fill, minmax(165px, 1fr)); gap: 12px; }
             .card { padding: 16px; }
             .table-wrap { margin: 0 -8px; }
         }
    </style>
</head>
<body class="theme-modern">
<header>
    <div style="display:flex; align-items:center;">
        <a href="<c:url value='/'/>" class="brand">NexoMart</a>
        <span class="tagline">Marketplace</span>
    </div>
    <div style="display:flex; align-items:center;">
        <%
            User navUser = (session == null) ? null : (User) session.getAttribute(AuthFilter.SESSION_USER_ATTR);
            if (navUser != null) {
        %>
        <a href="<c:url value='/products'/>">Browse</a>
        <a href="<c:url value='/cart'/>">Cart</a>
        <a href="<c:url value='/orders'/>">Orders</a>
        <% if (navUser.getRole().name().equals("SELLER")) { %>
        <a href="<c:url value='/products/create'/>">List a Product</a>
        <a href="<c:url value='/orders/seller'/>">My Sales</a>
        <% } %>
        <% if (navUser.getRole().name().equals("ADMIN")) { %>
        <a href="<c:url value='/admin/dashboard'/>">Admin Dashboard</a>
        <% } %>
            <span class="muted" style="margin:0 14px;">Hi, <c:out value="<%= navUser.getName() %>"/></span>
            <a href="<c:url value='/logout'/>" style="border:1px solid var(--border-strong); border-radius:var(--radius-sm);">Log out</a>
        <% } else { %>
        <a href="<c:url value='/products'/>">Browse</a>
        <a href="<c:url value='/login'/>" style="border:1px solid var(--border-strong); border-radius:var(--radius-sm); margin-left:8px;">Log in</a>
        <a href="<c:url value='/register'/>" class="btn" style="margin-left:8px;">Join</a>
        <% } %>
    </div>
</header>
<main>
<%
    Object flash = (session == null) ? null : session.getAttribute("flashMessage");
    if (flash != null) {
        session.removeAttribute("flashMessage");
        request.setAttribute("flashMessage", flash);
%>
    <div class="flash"><c:out value="${flashMessage}"/></div>
<% } %>
<c:if test="${not empty errorMessage}">
    <div class="error"><c:out value="${errorMessage}"/></div>
</c:if>