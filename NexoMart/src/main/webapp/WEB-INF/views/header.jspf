<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<%@ page import="com.nexomart.app.filter.AuthFilter" %>
<%@ page import="com.nexomart.app.model.User" %>
<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>NexoMart</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        /* ── TOKENS ── */
        :root {
            --bg:            #ffffff;
            --surface:       #ffffff;
            --border:        #d4d4d4;
            --border-strong: #000000;
            --accent:        #000000;
            --accent-hover:  #333333;
            --accent-light:  #f2f2f2;
            --on-accent:     #ffffff;
            --text:          #000000;
            --text-muted:    #555555;
            --text-faint:    #888888;
            --radius:        8px;
            --radius-sm:     6px;
            --shadow-sm:     0 1px 4px rgba(0,0,0,0.08);
            --shadow-md:     0 4px 18px rgba(0,0,0,0.13);
            --shadow-lg:     0 12px 40px rgba(0,0,0,0.18);
            /* chat widget compatibility */
            --brass:         #000000;
            --brass-hover:   #333333;
            --brass-light:   #f2f2f2;
        }

        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            background: #ffffff !important;
            color: #000000 !important;
            line-height: 1.6;
            -webkit-font-smoothing: antialiased;
        }

        /* ── HEADER ── */
        header {
            background: #ffffff !important;
            border-bottom: 2px solid #000000 !important;
            padding: 0 40px;
            height: 62px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            position: sticky;
            top: 0;
            z-index: 50;
            backdrop-filter: none !important;
        }

        header .brand {
            font-size: 20px;
            font-weight: 800;
            color: #000000 !important;
            text-decoration: none;
            letter-spacing: -0.04em;
            display: inline-flex;
            align-items: center;
            gap: 10px;
            margin-right: 28px;
        }

        header .brand::before {
            content: "N";
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 34px;
            height: 34px;
            border-radius: 6px;
            background: #000000 !important;
            color: #ffffff !important;
            font-size: 16px;
            font-weight: 800;
            box-shadow: none !important;
        }

        .tagline { color: #888888; font-size: 11px; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; margin-right: auto; }

        header a { color: #000000 !important; text-decoration: none; font-size: 14px; font-weight: 500; padding: 6px 12px; border-radius: 6px; transition: background 0.12s; }
        header a:hover { background: #f2f2f2 !important; color: #000000 !important; }

        /* ── MAIN ── */
        main { max-width: 1160px; margin: 36px auto 64px; padding: 0 20px; }

        /* ── GLOBAL OVERRIDES — forces all inline JSP styles to black & white ── */

        /* All cards / boxes */
        .card, .sand-card, .auth-card, .wish-card {
            background: #ffffff !important;
            border: 1.5px solid #000000 !important;
            border-radius: 8px !important;
            box-shadow: 0 1px 4px rgba(0,0,0,0.08) !important;
            color: #000000 !important;
        }

        /* Product grid image — always visible */
        .product-grid .card { padding: 0 !important; overflow: hidden; }
        .product-grid .card img {
            width: 100%;
            height: 200px;
            object-fit: cover;
            display: block !important;
            border-bottom: 1.5px solid #000000;
            background: #f2f2f2;
        }
        .product-grid .card-body { padding: 16px; }
        .product-grid .card > a > img { display: block !important; }

        /* All text colours */
        h1, h2, h3, h4, h5, h6,
        .page-title, .sand-card h3,
        .order-head, .order-head strong,
        .auth-card h2 {
            color: #000000 !important;
            font-family: 'Inter', sans-serif !important;
            font-weight: 800 !important;
        }

        p, td, li, span, div,
        .order-meta, .order-date,
        .auth-sub, .auth-foot,
        .empty-note, .mock-note,
        .muted, .tagline {
            color: #000000 !important;
        }

        .muted, .order-date, .auth-sub, .auth-foot, .auth-demo,
        .order-meta, .empty-note { color: #555555 !important; }

        /* Links */
        a { color: #000000 !important; }
        .auth-foot a, .empty-note a, .back-link { color: #000000 !important; font-weight: 700 !important; }

        /* All form inputs */
        input, select, textarea {
            width: 100%;
            padding: 11px 13px !important;
            margin: 6px 0 14px !important;
            border: 1.5px solid #000000 !important;
            border-radius: 6px !important;
            background: #ffffff !important;
            color: #000000 !important;
            font-family: inherit;
            font-size: 14px;
            outline: none;
        }

        input:focus, select:focus, textarea:focus {
            box-shadow: 0 0 0 3px rgba(0,0,0,0.12) !important;
        }

        label { color: #555555 !important; font-weight: 600 !important; font-size: 12px !important; text-transform: uppercase !important; letter-spacing: 0.05em !important; }

        /* All buttons — black box, white text */
        button, .btn, .sand-btn,
        .auth-card button[type=submit],
        .sand-table button,
        .sand-card button,
        .btn-ship, .btn-wish-cart {
            background: #000000 !important;
            color: #ffffff !important;
            border: 1.5px solid #000000 !important;
            border-radius: 6px !important;
            padding: 10px 20px !important;
            font-size: 14px !important;
            font-weight: 700 !important;
            cursor: pointer !important;
            font-family: inherit !important;
            box-shadow: none !important;
        }

        button:hover, .btn:hover, .sand-btn:hover,
        .auth-card button[type=submit]:hover,
        .sand-table button:hover {
            background: #333333 !important;
            border-color: #333333 !important;
        }

        /* Danger / outline buttons — white box, black text */
        button.btn-danger, .btn-outline,
        .auth-card button.btn-danger,
        .btn-wish-remove {
            background: #ffffff !important;
            color: #000000 !important;
            border: 1.5px solid #000000 !important;
        }

        button.btn-danger:hover, .btn-outline:hover, .btn-wish-remove:hover {
            background: #f2f2f2 !important;
        }

        /* Tables */
        th { border-bottom: 2px solid #000000 !important; color: #555555 !important; }
        td { border-bottom: 1px solid #d4d4d4 !important; color: #000000 !important; }
        tr:last-child td { border-bottom: none !important; }
        .sand-table th { border-bottom: 2px solid #000000 !important; color: #555555 !important; }
        .sand-table td { border-bottom: 1px solid #d4d4d4 !important; color: #000000 !important; }

        /* Price */
        .price, .total-line, .total-line strong,
        td.price { color: #000000 !important; font-weight: 700 !important; }

        /* Badges */
        .status-badge, .role-badge {
            background: #000000 !important;
            color: #ffffff !important;
            border-radius: 999px !important;
            padding: 3px 12px !important;
            font-size: 11.5px !important;
            font-weight: 700 !important;
        }

        /* Flash / error banners */
        .flash {
            background: #000000 !important;
            color: #ffffff !important;
            border: none !important;
            padding: 12px 16px !important;
            border-radius: 6px !important;
            margin-bottom: 16px;
        }

        .error, .alert-error, .form-error {
            background: #ffffff !important;
            border: 1.5px solid #000000 !important;
            color: #000000 !important;
            padding: 12px 16px !important;
            border-radius: 6px !important;
            margin-bottom: 16px;
        }

        /* Auth demo box */
        .auth-demo, .mock-note {
            background: #f2f2f2 !important;
            border: 1.5px dashed #000000 !important;
            color: #555555 !important;
            border-radius: 6px !important;
        }

        /* Product card hover */
        .product-grid .card:hover {
            box-shadow: 0 4px 18px rgba(0,0,0,0.13) !important;
            transform: translateY(-3px);
            border-color: #000000 !important;
        }

        /* Category tiles */
        .category-tile {
            background: #ffffff !important;
            border: 1.5px solid #000000 !important;
            color: #000000 !important;
        }
        .category-tile:hover { background: #f2f2f2 !important; }

        /* Section headings */
        .section-heading a { color: #000000 !important; }

        /* Eyebrow */
        .eyebrow { color: #000000 !important; }
        .eyebrow::before { background: #000000 !important; }

        /* Hover rows */
        .sand-table tr:hover td { background: #f9f9f9 !important; }

        /* Wishlist */
        .wish-img {
            width: 100%; height: 180px; object-fit: cover;
            display: block !important;
            border-bottom: 1.5px solid #000000;
            background: #f2f2f2;
        }

        /* Chat widget button colour fix */
        #cm-chat-btn { background: #000000 !important; }
        #cm-chat-btn:hover { background: #333333 !important; }
        .cm-chat-head { background: #000000 !important; }
        .cm-chat-send { background: #000000 !important; }
        .cm-chat-send:hover { background: #333333 !important; }
        .cm-chat-input:focus { border-color: #000000 !important; }
        .cm-chip:hover { border-color: #000000 !important; color: #000000 !important; }

        /* Responsive */
        @media (max-width: 760px) {
            header { padding: 0 16px; height: auto; min-height: 56px; flex-wrap: wrap; gap: 8px; padding-top: 10px; padding-bottom: 10px; }
            header > div:last-child { flex-wrap: wrap; justify-content: flex-end; }
            header a { padding: 5px 8px; font-size: 12px; }
            header .brand { margin-right: 0; font-size: 17px; }
            .tagline { display: none; }
            main { margin-top: 20px; padding: 0 12px; }
            .product-grid { grid-template-columns: repeat(auto-fill, minmax(155px, 1fr)); gap: 12px; }
        }

        /* Product grid layout */
        .product-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); gap: 20px; }
        .category-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(155px, 1fr)); gap: 14px; }
        .wish-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 20px; }
    </style>
</head>
<body>
<header>
    <div style="display:flex; align-items:center;">
        <a href="<c:url value='/'/>" class="brand">NexoMart</a>
        <span class="tagline">Marketplace</span>
    </div>
    <div style="display:flex; align-items:center; gap:2px;">
        <%
            User navUser = (session == null) ? null : (User) session.getAttribute(AuthFilter.SESSION_USER_ATTR);
            if (navUser != null) {
        %>
        <a href="<c:url value='/products'/>">Browse</a>
        <a href="<c:url value='/cart'/>">Cart</a>
        <a href="<c:url value='/orders'/>">Orders</a>
        <% if (navUser.getRole().name().equals("BUYER")) { %>
        <a href="<c:url value='/wishlist'/>">Wishlist</a>
        <% } %>
        <% if (navUser.getRole().name().equals("SELLER")) { %>
        <a href="<c:url value='/products/create'/>">List a Product</a>
        <a href="<c:url value='/orders/seller'/>">My Sales</a>
        <% } %>
        <% if (navUser.getRole().name().equals("ADMIN")) { %>
        <a href="<c:url value='/admin/dashboard'/>">Admin Dashboard</a>
        <% } %>
        <span style="margin:0 12px; font-size:13px; color:#555;">Hi, <c:out value="<%= navUser.getName() %>"/></span>
        <a href="<c:url value='/logout'/>" style="border:1.5px solid #000; border-radius:6px;">Log out</a>
        <% } else { %>
        <a href="<c:url value='/products'/>">Browse</a>
        <a href="<c:url value='/login'/>" style="border:1.5px solid #000; border-radius:6px; margin-left:8px;">Log in</a>
        <a href="<c:url value='/register'/>" class="btn" style="margin-left:8px;">Join</a>
        <% } %>
    </div>
</header>
<main>
<%
    Object flash = (session == null) ? null : session.getAttribute("flashMessage");
    if (flash != null) {
        session.removeAttribute("flashMessage");
        request.setAttribute("flashMessage", flash);
%>
    <div class="flash"><c:out value="${flashMessage}"/></div>
<% } %>
<c:if test="${not empty errorMessage}">
    <div class="error"><c:out value="${errorMessage}"/></div>
</c:if>